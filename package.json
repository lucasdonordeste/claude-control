{
  "name": "claude-control",
  "displayName": "Claude Control",
  "description": "Control panel for Claude Code in your sidebar — watch every live session and its subagent tree, get told when one needs you, diagnose broken hooks and exposed secrets, see token & cache analytics, and edit models, permissions, MCP servers, skills and hooks without touching JSON. No telemetry.",
  "version": "1.5.0",
  "publisher": "lucasdonordeste",
  "author": {
    "name": "Lucas do Nordeste"
  },
  "license": "MIT",
  "icon": "media/logo.png",
  "homepage": "https://github.com/lucasdonordeste/claude-control#readme",
  "bugs": {
    "url": "https://github.com/lucasdonordeste/claude-control/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasdonordeste/claude-control.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "ai",
    "agents",
    "mcp",
    "skills",
    "plugins",
    "sidebar",
    "control panel"
  ],
  "galleryBanner": {
    "color": "#1d1a18",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "lint": "eslint .",
    "test": "node --test",
    "package": "vsce package -o claude-control.vsix",
    "publish:ovsx": "ovsx publish claude-control.vsix -p $OVSX_PAT",
    "publish:vsce": "vsce publish --packagePath claude-control.vsix -p $VSCE_PAT",
    "vscode:prepublish": "npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@vscode/vsce": "^3.2.0",
    "eslint": "^9.15.0",
    "ovsx": "^0.10.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeControl",
          "title": "Claude Control",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeControl": [
        {
          "id": "claudeControlView",
          "name": "Claude Control",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeControl.refresh",
        "title": "%command.refresh.title%",
        "category": "Claude Control",
        "icon": "$(refresh)"
      },
      {
        "command": "claudeControl.showLive",
        "title": "%command.showLive.title%",
        "category": "Claude Control",
        "icon": "$(pulse)"
      },
      {
        "command": "claudeControl.doctor",
        "title": "%command.doctor.title%",
        "category": "Claude Control",
        "icon": "$(shield)"
      },
      {
        "command": "claudeControl.metrics",
        "title": "%command.metrics.title%",
        "category": "Claude Control",
        "icon": "$(graph)"
      },
      {
        "command": "claudeControl.searchPrompts",
        "title": "%command.searchPrompts.title%",
        "category": "Claude Control",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeControl.refresh",
          "when": "view == claudeControlView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Claude Control",
      "properties": {
        "claudeControl.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.desc%"
        },
        "claudeControl.statusBar.show5h": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.show5h%"
        },
        "claudeControl.statusBar.show7d": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.show7d%"
        },
        "claudeControl.statusBar.showContext": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showContext%"
        },
        "claudeControl.statusBar.showSessions": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.showSessions%"
        },
        "claudeControl.alertWaiting": {
          "type": "boolean",
          "default": true,
          "description": "%config.alertWaiting%"
        },
        "claudeControl.metrics.days": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 365,
          "description": "%config.metrics.days%"
        },
        "claudeControl.archive.days": {
          "type": "number",
          "default": 90,
          "minimum": 7,
          "maximum": 3650,
          "description": "%config.archive.days%"
        },
        "claudeControl.statusBar.colorMode": {
          "type": "string",
          "enum": [
            "adaptive",
            "usage",
            "custom",
            "none"
          ],
          "enumDescriptions": [
            "%config.statusBar.colorMode.adaptive%",
            "%config.statusBar.colorMode.usage%",
            "%config.statusBar.colorMode.custom%",
            "%config.statusBar.colorMode.none%"
          ],
          "default": "adaptive",
          "description": "%config.statusBar.colorMode.desc%"
        },
        "claudeControl.statusBar.customColor": {
          "type": "string",
          "default": "",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}))?$",
          "patternErrorMessage": "%config.statusBar.customColor.err%",
          "description": "%config.statusBar.customColor.desc%"
        },
        "claudeControl.planUsage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.planUsage.enabled%"
        },
        "claudeControl.live.refreshSeconds": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 60,
          "description": "%config.live.refreshSeconds%"
        },
        "claudeControl.live.expandAgents": {
          "type": "string",
          "enum": [
            "always",
            "whileRunning",
            "never"
          ],
          "enumDescriptions": [
            "%config.live.expandAgents.always%",
            "%config.live.expandAgents.whileRunning%",
            "%config.live.expandAgents.never%"
          ],
          "default": "always",
          "description": "%config.live.expandAgents%"
        },
        "claudeControl.statusBar.alignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "%config.statusBar.alignment%"
        },
        "claudeControl.doctor.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "description": "%config.doctor.ignore%"
        }
      }
    }
  }
}
